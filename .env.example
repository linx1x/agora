# Copy to .env for local runs. Never commit .env.
NODE_ENV=development
PORT=3000
# dev = pick a test user (refused when NODE_ENV=production); access-code = name + shared code (pilot);
# passkey = invite-only accounts (ADR-032, docs/AUTH.md; sign-in arrives with P2.13/P2.14)
AUTH_MODE=dev
ACCESS_CODE=
# 32+ random chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Sessions (P2.12): normal sessions last SESSION_DAYS and renew while used;
# "shared computer" sessions (Remember me unticked) last SESSION_HOURS and end with the browser.
SESSION_DAYS=30
SESSION_HOURS=12
# Where browsers load Agora from (comma-separated). POST/PATCH/DELETE from other origins are refused.
# Empty = the request's own host only. Production: https://agora.example.com
PUBLIC_ORIGIN=
# Passkey domain (default: the PUBLIC_ORIGIN host). Changing it later invalidates every passkey.
PASSKEY_RP_ID=
# Passkey mode: also write the owner setup link to this file (mode 600)
SETUP_LINK_FILE=
DATABASE_URL=postgres://postgres:secret@localhost:5432/agora
# Media (ADR-031): LiveKit SFU when LIVEKIT_URL is set, else peer-to-peer.
# Local: run `pnpm livekit` (livekit-server --dev) and use ws://localhost:7880, devkey, secret.
# Remote users need wss:// (TLS) and the ports in infra/livekit.yaml.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only when the server reaches the LiveKit API at another address (e.g. http://livekit:7880 in Docker)
LIVEKIT_API_URL=
# livekit | p2p (default: livekit when LIVEKIT_URL is set)
MEDIA_BACKEND=
# P2P fallback only: JSON array of RTCIceServer, e.g. [{"urls":"turn:turn.example.org:3478","username":"u","credential":"p"}]
ICE_SERVERS=
SPACE_CAPACITY=50
CONNECT_R=5
DISCONNECT_R=6
VIDEO_CAP=9
FEATURE_FLAGS=
CHAT_RETENTION_DAYS=365
LOG_LEVEL=info
# Pilot modes only (ignored with AUTH_MODE=passkey, where roles live in the database):
# Build mode (ADR-021): user ids allowed to edit the map, and/or a code that unlocks it in Settings
BUILDER_IDS=dev-alice
BUILDER_CODE=
# Platform admins (admin in every space: settings, invites), and/or a 12+ char code that unlocks it in Settings
ADMIN_IDS=
ADMIN_CODE=
# Who may create spaces: everyone | admins
SPACE_CREATION=everyone
# Name of the default space (created on first boot)
HQ_NAME=Agora
# Access-code mode: days a browser keeps its identity ("Remember me"), 0 = never
IDENTITY_DAYS=365
# Without Postgres, builder edits are kept here (development default)
MAP_SAVE_PATH=

# NPCs (Phase 15, ADR-042; spike P15.1 in spikes/npc-brain). Off until the `npcs` flag ships.
# Talking (P15.4, ADR-045) needs FEATURE_FLAGS=npcs=true,npcTalk=true. Prepared lines and the
# Q&A answer most messages with no model at all; the LLM only writes what none of them covers.
# DeepSeek stores data in China: with it the AI notice (Law 25) names the provider and country and
# each person must accept it before Talk works. Any OpenAI-compatible or Anthropic endpoint works.
# Empty key = no cloud model at all (prepared lines only, no notice).
NPC_LLM_PROVIDER=openai
NPC_LLM_BASE_URL=https://api.deepseek.com
NPC_LLM_MODEL=deepseek-flash
NPC_LLM_API_KEY=
# DeepSeek thinks by default; NPC lines do not need it (off is the default on deepseek.com)
NPC_LLM_THINKING=off
NPC_LLM_TIMEOUT_MS=8000
# Shown in the notice; guessed from the host when empty (deepseek.com: DeepSeek / CN)
NPC_LLM_LABEL=
NPC_LLM_COUNTRY=
# Cloud-model calls per hour per character, and a daily spend ceiling in US dollars
NPC_CALLS_PER_HOUR=60
NPC_LLM_DAILY_USD=1
# Memory (P15.5, FEATURE_FLAGS=npcMemory=true; needs a cloud model to write the notes): notes a
# character keeps about a person are deleted after this many days without a refresh
NPC_MEMORY_DAYS=90
# Voices (P15.6, ADR-048, FEATURE_FLAGS=npcVoice=true): the voice service in apps/ml on your machine
# (bash apps/ml/run.sh --voice chatterbox). Empty = text only. People also turn "Character voices" on.
NPC_VOICE_URL=
NPC_VOICE_TOKEN=
NPC_VOICE_TIMEOUT_MS=20000
# Web lookups (P15.8, ADR-049, FEATURE_FLAGS=npcWeb=true; needs a cloud model): your own SearXNG with
# JSON output enabled (search.formats: [html, json]). The words of a question, without names, reach the
# search engines it uses; turning this on asks everyone to accept the AI notice again.
NPC_WEB=off
NPC_WEB_URL=
# Only these sites (and subdomains) may be quoted, comma separated; empty = any
NPC_WEB_SITES=
NPC_WEB_TIMEOUT_MS=4000
NPC_WEB_PER_HOUR=30
# Social life (FEATURE_FLAGS=npcSocial=true): moods, a character's day kept across restarts, characters
# chatting from prepared lines (only while a person is within earshot). Weekly line proposals:
#   pnpm tsx scripts/npc-lines.ts   (writes data/npcs/<id>.lines.proposed.json for you to review)
# NPC_LLM_PROVIDER=fake is a stand-in for tests and local trials; it refuses to start in production
# Clef-flash decides (apps/ml, P15.3, ADR-044): start it in WSL2 with `bash apps/ml/run.sh`, then
# NPC_DECIDE_URL=http://127.0.0.1:8790. Empty (or NPC_DECIDE_PROVIDER=off): the characters' own
# scoring decides what they do. Body decisions never go to the cloud model.
NPC_DECIDE_PROVIDER=clef
NPC_DECIDE_URL=
# A Clef answer counts only at or above this probability; below it, the safe default applies
NPC_DECIDE_MIN_P=0.7
NPC_DECIDE_TIMEOUT_MS=1500
# Only when apps/ml listens beyond localhost (same value as ML_TOKEN there)
NPC_DECIDE_TOKEN=
# Local decision log (one JSON line per decision, no names, no Talk text), for fitting the scoring
# to Clef later. Development default data/npc-log; `off` to disable; off in production unless set.
NPC_LOG_DIR=
NPC_LOG_DAYS=30
# Bodies (P15.2, ADR-043): FEATURE_FLAGS=npcs=true, then which spaces have characters (ids or addresses)
NPC_SPACES=hq
# Character files (<id>.json); development default data/npcs, filled with Zoé, Félix and Théo the first time
NPC_DIR=
# Development only (ignored in production): start the characters' clock at HH:MM and speed it up
# (60 = one game hour per real minute)
NPC_CLOCK=
NPC_TIME_SCALE=1
