# Copy to .env for local runs. Never commit .env.
NODE_ENV=development
PORT=3000
# dev = pick a test user (refused when NODE_ENV=production); access-code = name + shared code (pilot);
# passkey = invite-only accounts (ADR-032, docs/AUTH.md; sign-in arrives with P2.13/P2.14)
AUTH_MODE=dev
ACCESS_CODE=
# 32+ random chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Sessions (P2.12): normal sessions last SESSION_DAYS and renew while used;
# "shared computer" sessions (Remember me unticked) last SESSION_HOURS and end with the browser.
SESSION_DAYS=30
SESSION_HOURS=12
# Where browsers load Agora from (comma-separated). POST/PATCH/DELETE from other origins are refused.
# Empty = the request's own host only. Production: https://agora.example.com
PUBLIC_ORIGIN=
# Passkey domain (default: the PUBLIC_ORIGIN host). Changing it later invalidates every passkey.
PASSKEY_RP_ID=
# Passkey mode: also write the owner setup link to this file (mode 600)
SETUP_LINK_FILE=
DATABASE_URL=postgres://postgres:secret@localhost:5432/agora
# Media (ADR-031): LiveKit SFU when LIVEKIT_URL is set, else peer-to-peer.
# Local: run `pnpm livekit` (livekit-server --dev) and use ws://localhost:7880, devkey, secret.
# Remote users need wss:// (TLS) and the ports in infra/livekit.yaml.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only when the server reaches the LiveKit API at another address (e.g. http://livekit:7880 in Docker)
LIVEKIT_API_URL=
# livekit | p2p (default: livekit when LIVEKIT_URL is set)
MEDIA_BACKEND=
# P2P fallback only: JSON array of RTCIceServer, e.g. [{"urls":"turn:turn.example.org:3478","username":"u","credential":"p"}]
ICE_SERVERS=
SPACE_CAPACITY=50
CONNECT_R=5
DISCONNECT_R=6
VIDEO_CAP=9
FEATURE_FLAGS=
CHAT_RETENTION_DAYS=365
LOG_LEVEL=info
# Pilot modes only (ignored with AUTH_MODE=passkey, where roles live in the database):
# Build mode (ADR-021): user ids allowed to edit the map, and/or a code that unlocks it in Settings
BUILDER_IDS=dev-alice
BUILDER_CODE=
# Platform admins (admin in every space: settings, invites), and/or a 12+ char code that unlocks it in Settings
ADMIN_IDS=
ADMIN_CODE=
# Who may create spaces: everyone | admins
SPACE_CREATION=everyone
# Name of the default space (created on first boot)
HQ_NAME=Agora
# Access-code mode: days a browser keeps its identity ("Remember me"), 0 = never
IDENTITY_DAYS=365
# Without Postgres, builder edits are kept here (development default)
MAP_SAVE_PATH=
