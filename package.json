{
  "name": "agora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @agora/web build && pnpm --filter @agora/server build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "map:build": "tsx packages/maps/scripts/build-hq.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "assets:check": "tsx scripts/assets-check.ts",
    "infra:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --wait db",
    "infra:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "bots": "tsx scripts/bots.ts",
    "owner:recover": "tsx apps/server/src/cli.ts owner:recover",
    "pilot:purge": "tsx apps/server/src/cli.ts pilot:purge",
    "livekit": "livekit-server --dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/**/*.ts\" \"e2e/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "@types/ws": "^8.18.0"
  }
}
